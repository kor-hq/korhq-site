{
  "formatter": {
    "external": {
      "command": "node_modules/.bin/prettierd",
      "arguments": ["{buffer_path}"]
    }
  },
  "format_on_save": "on",
  "tab_size": 2,
  "lsp": {
    "tailwindcss-language-server": {
      "settings": {
        "classFunctions": ["cva", "cx", "tv"]
      }
    }
  }
}
