---
import Layout from "../layouts/Layout.astro";
import { Button } from "@korhq/ui/button";
import { Icon } from "astro-icon/components";
import ProjectCard from "../components/ProjectCard.astro";
---

<Layout title="Home">
    <main class="p-8 pt-4 flex flex-col gap-2">
        <h3 class="title-3">Projects</h3>
        <div class="grid grid-cols-5 aspect-[5/1] w-full h-auto gap-1.5">
            <ProjectCard label="Bibleio" />
            <ProjectCard label="KORUI" />
            <ProjectCard label="unDocs" />
            <ProjectCard label="Alive" />
            <ProjectCard label="Slate" />
        </div>
        <h3 class="title-3">Handbook</h3>
        <div class="grid grid-cols-5 aspect-[5/1] w-full h-auto gap-1.5">
            <ProjectCard label="About">
                <Icon name="ph:info-fill" class="size-8" />
            </ProjectCard>
            <ProjectCard label="Brand & Design">
                <Icon name="ph:paint-brush-household-fill" class="size-8" />
            </ProjectCard>
            <ProjectCard label="Engineering">
                <Icon name="ph:brackets-curly-fill" class="size-8" />
            </ProjectCard>
            <ProjectCard label="Donate">
                <Icon name="ph:heart-fill" class="size-8" />
            </ProjectCard>
            <ProjectCard label="Contact">
                <Icon name="ph:paper-plane-tilt-fill" class="size-8" />
            </ProjectCard>
        </div>
    </main>
</Layout>
