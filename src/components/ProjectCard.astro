---
export interface Props {
  label: string;
  href?: string;
  class?: string;
}

const { label, href, class: className } = Astro.props;

const Component = href ? "a" : "div";
---

<Component
  href={href}
  class:list={[
    "border-stroke rounded-12 group flex cursor-pointer flex-col items-center justify-center gap-2 border transition-[filter] duration-200 ease-out hover:brightness-110",
    className,
  ]}
>
  <div
    class="bg-surface-primary border-stroke shadow-glass rounded-20 flex size-18 items-center justify-center border duration-200 ease-out group-hover:scale-105 group-active:scale-[95%]"
  >
    <slot />
  </div>
  <p class="body">{label}</p>
</Component>
